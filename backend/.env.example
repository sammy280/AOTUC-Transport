# ==============================================================================
# AOTUC-TRANSPORT v2.0 — Backend Environment Configuration Template
# ==============================================================================
# IMPORTANT: Copy this file to '.env' and populate with your local values.
# NEVER commit the actual '.env' file or any real secrets to version control.
# ==============================================================================

# Server Network Configuration
NODE_ENV=development
PORT=5000
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL with PostGIS)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/aotuc_transport?schema=public"

# Authentication & Security
# Generate cryptographically random strings for secrets (e.g., openssl rand -base64 48)
JWT_ACCESS_SECRET="CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_AT_LEAST_32_CHARS"
JWT_REFRESH_SECRET="CHANGE_THIS_TO_A_DIFFERENT_SECURE_RANDOM_SECRET_AT_LEAST_32_CHARS"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Argon2 Password Hashing Options
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug

# Storage & Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_BYTES=5242880

# QR Code Cryptographic Signing (Ed25519)
# In production, keys must be loaded from secure key storage
QR_KEY_ID="aotuc-key-2026-v1"
QR_PRIVATE_KEY_BASE64="GENERATE_ED25519_PRIVATE_KEY_BASE64"
QR_PUBLIC_KEY_BASE64="GENERATE_ED25519_PUBLIC_KEY_BASE64"

# SMS Gateway Configuration (Mocked during initial phases)
SMS_PROVIDER="mock"
ORANGE_SMS_CLIENT_ID=""
ORANGE_SMS_CLIENT_SECRET=""
MTN_SMS_API_KEY=""
