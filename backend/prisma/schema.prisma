// AOTUC-TRANSPORT v2.0 — Prisma Database Schema
// Database: PostgreSQL 18 with PostGIS

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ==============================================================================
// 1. ORGANIZATIONAL SCOPE & ADMINISTRATIVE DIVISIONS
// ==============================================================================

model Commune {
  id                   String   @id @default(uuid())
  code                 String   @unique // e.g., "KLM", "DXN", "MTM", "RTM", "MTT"
  name                 String   @unique // e.g., "Kaloum", "Dixinn", "Matam", "Ratoma", "Matoto"
  description          String?
  administrativeOrigin String?  @map("administrative_origin")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  users              User[]
  persons            Person[]
  unions             TransportUnion[]
  authorities        Authority[]
  validationRequests ValidationRequest[]
  stops              TransportStop[]
  fieldAssignments   FieldAssignment[]
  fieldTeams         FieldTeam[]
  fieldReceipts      FieldReceipt[]
  fieldInspections   FieldInspection[]     @relation("CommuneFieldInspections")

  @@map("communes")
}

// ==============================================================================
// 2. USERS, ROLES, AND AUTHENTICATION
// ==============================================================================

enum RoleType {
  SUPER_ADMIN
  DIRECTOR
  CHEF_SERVICE
  AGENT_TERRAIN
  SYNDICAT
  DISTRIBUTEUR
  AUTHORITY
}

model Role {
  id          String   @id @default(uuid())
  name        RoleType @unique
  labelFr     String   @map("label_fr") // Human readable French label
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  userRoles UserRole[]

  @@map("roles")
}


enum UserAccountStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  phoneNumber  String   @unique @map("phone_number")
  passwordHash String   @map("password_hash")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  jobTitle     String?  @map("job_title")
  avatarUrl    String?  @map("avatar_url")
  isActive     Boolean  @default(true) @map("is_active")

  // Territorial / Departmental Scope
  communeId String?  @map("commune_id")
  commune   Commune? @relation(fields: [communeId], references: [id], onDelete: SetNull)

  // Union Scope (for SYNDICAT role users)
  unionId String?         @map("union_id")
  union   TransportUnion? @relation(fields: [unionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  roles                       UserRole[]
  refreshTokens               RefreshToken[]
  auditLogs                   AuditLog[]            @relation("ActorAuditLogs")
  uploadedDocuments           Document[]            @relation("UploadedByUser")
  vehicleAssignments          VehicleAssignment[]   @relation("AssignedByUser")
  submittedValidationRequests ValidationRequest[]   @relation("SubmittedValidationRequests")
  reviewedValidationSteps     ValidationStep[]      @relation("ReviewerValidationSteps")
  allocatedTicketBatches      TicketBatch[]
  recordedTicketSales         TicketSale[]
  recordedLedgerEntries       FinancialLedgerEntry[]
  assignedFieldAssignments   FieldAssignment[]     @relation("AssignedFieldAssignments")
  supervisedFieldAssignments FieldAssignment[]     @relation("SupervisedFieldAssignments")
  agentFieldReceipts         FieldReceipt[]        @relation("AgentFieldReceipts")
  ledFieldTeams              FieldTeam[]           @relation("LeaderFieldTeams")
  registeredAuthorities      Authority[]           @relation("RegisteredAuthorities")
  // Professional Agent Identity & Granular Account Status
  employeeNumber String?           @unique @map("employee_number")
  address        String?
  accountStatus  UserAccountStatus @default(ACTIVE) @map("account_status")

  assignedTeamId String?           @map("assigned_team_id")
  assignedTeam   FieldTeam?        @relation("TeamMembers", fields: [assignedTeamId], references: [id], onDelete: SetNull)

  cancelledFieldAssignments   FieldAssignment[]      @relation("CancelledFieldAssignments")
  assignedMissionAgents       FieldAssignmentAgent[] @relation("AssignedMissionAgents")
  agentFieldInspections       FieldInspection[]      @relation("AgentFieldInspections")
  leadAuthorMissionReports    MissionReport[]        @relation("LeadAuthorMissionReports")
  reviewedMissionReports      MissionReport[]        @relation("ReviewedMissionReports")
  submittedReportVersions     MissionReportVersion[] @relation("SubmittedReportVersions")
  reviewedReportVersions      MissionReportVersion[] @relation("ReviewedReportVersions")


  @@index([phoneNumber])
  @@index([email])
  @@index([communeId])
  @@index([unionId])
  @@map("users")
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

// ==============================================================================
// 3. REFRESH TOKEN ROTATION & SESSION INTEGRITY
// ==============================================================================

model RefreshToken {
  id              String   @id @default(uuid())
  tokenHash       String   @unique @map("token_hash")
  userId          String   @map("user_id")
  family          String // UUID representing token issuance lineage for reuse detection
  isRevoked       Boolean  @default(false) @map("is_revoked")
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")
  replacedByToken String?  @map("replaced_by_token")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

// ==============================================================================
// 4. AUDIT LOGGING & COMPLIANCE
// ==============================================================================

model AuditLog {
  id             String   @id @default(uuid())
  actorId        String?  @map("actor_id")
  action         String // e.g., "USER_LOGIN", "DRIVER_ENROLLED", "DOCUMENT_UPLOADED"
  targetModule   String   @map("target_module") // e.g., "AUTH", "REGISTRATION", "DOCUMENTS"
  targetRecordId String?  @map("target_record_id")
  previousValues Json?    @map("previous_values")
  newValues      Json?    @map("new_values")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  reason         String?
  timestamp      DateTime @default(now())

  actor User? @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([targetModule])
  @@index([timestamp])
  @@map("audit_logs")
}

// ==============================================================================
// 5. PERSON IDENTITY REGISTRY (Module 2)
// ==============================================================================

model Person {
  id          String    @id @default(uuid())
  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  nin         String    @unique // Guinean National Identification Number (NIN)
  phoneNumber String    @unique @map("phone_number") // Normalized E.164 (+224...)
  email       String?
  dateOfBirth DateTime? @map("date_of_birth")
  address     String?

  communeId String?  @map("commune_id")
  commune   Commune? @relation(fields: [communeId], references: [id], onDelete: SetNull)

  // Field Registration GPS & Provenance
  latitude           Float?
  longitude          Float?
  gpsCapturedAt      DateTime? @map("gps_captured_at")
  registeredByUserId String?   @map("registered_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  driver        Driver?
  owner         Owner?
  documents     Document[]
  fieldReceipts FieldReceipt[]
  fieldInspections FieldInspection[] @relation("PersonFieldInspections")

  @@index([nin])
  @@index([phoneNumber])
  @@index([communeId])
  @@map("persons")
}

// ==============================================================================
// 6. DRIVERS & LICENCES (Module 2)
// ==============================================================================

enum DriverStatus {
  BROUILLON
  EN_ATTENTE_VALIDATION
  ACTIF
  SUSPENDU
  INACTIF
}

model Driver {
  id                    String       @id @default(uuid())
  personId              String       @unique @map("person_id")
  drivingLicenseNumber  String       @unique @map("driving_license_number")
  licenseCategory       String       @default("B") @map("license_category") // e.g., "B", "C", "D"
  licenseExpirationDate DateTime     @map("license_expiration_date")
  status                DriverStatus @default(EN_ATTENTE_VALIDATION)
  isPaymentConfirmed    Boolean      @default(true) @map("is_payment_confirmed")

  // Emergency Contact Information (Nullable for backward compatibility with existing drivers)
  emergencyContactName     String?   @map("emergency_contact_name")
  emergencyContactPhone    String?   @map("emergency_contact_phone")
  emergencyContactRelation String?   @map("emergency_contact_relation")

  unionId String?         @map("union_id")
  union   TransportUnion? @relation(fields: [unionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  person      Person              @relation(fields: [personId], references: [id], onDelete: Restrict)
  assignments VehicleAssignment[]
  badges      DriverBadge[]
  fieldInspections FieldInspection[] @relation("DriverFieldInspections")

  @@index([drivingLicenseNumber])
  @@index([status])
  @@index([unionId])
  @@map("drivers")
}

// ==============================================================================
// 7. VEHICLE OWNERS (Module 2)
// ==============================================================================

enum OwnerType {
  INDIVIDU
  ENTREPRISE
}

model Owner {
  id           String    @id @default(uuid())
  personId     String    @unique @map("person_id")
  ownerType    OwnerType @default(INDIVIDU) @map("owner_type")
  businessName String?   @map("business_name")
  taxNumber    String?   @map("tax_number") // Numéro d'Identification Fiscale (NIF)
  unionId      String?   @map("union_id")
  union        TransportUnion? @relation(fields: [unionId], references: [id], onDelete: SetNull)

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  person   Person    @relation(fields: [personId], references: [id], onDelete: Restrict)
  vehicles Vehicle[]

  @@index([unionId])
  @@map("owners")
}

// ==============================================================================
// 8. VEHICLES & INSPECTIONS (Module 2)
// ==============================================================================

enum VehicleType {
  TAXI_COLLECTIF
  MAGBANA_MINIBUS
  BUS_URBAIN
  MOTOTAXI
  AUTRE
}

enum VehicleStatus {
  BROUILLON
  EN_ATTENTE_VALIDATION
  ACTIF
  EN_PANNE
  SUSPENDU
  RETIRE
}

model Vehicle {
  id                     String        @id @default(uuid())
  ownerId                String        @map("owner_id")
  plateNumber            String        @unique @map("plate_number") // Plaque d'immatriculation (ex: RC-1234-A)
  registrationCardNumber String        @unique @map("registration_card_number") // Numéro carte grise
  chassisVin             String        @unique @map("chassis_vin") // Numéro de châssis / VIN
  atrNumber              String?       @map("atr_number") // Numéro officiel d'autorisation du transporteur en Guinée (ATR)
  aotucLicenseNumber     String?       @map("aotuc_license_number") // Numéro de licence AOTUC
  vehicleType            VehicleType   @map("vehicle_type")
  make                   String // Marque (ex: Toyota)
  model                  String // Modèle (ex: Corolla)
  year                   Int? // Année de mise en circulation
  seatingCapacity        Int?          @map("seating_capacity")
  status                 VehicleStatus @default(EN_ATTENTE_VALIDATION)
  isPaymentConfirmed     Boolean       @default(true) @map("is_payment_confirmed")
  superAdminConfirmed    Boolean       @default(true) @map("super_admin_confirmed")

  // Field Registration GPS & Provenance
  latitude               Float?
  longitude              Float?
  gpsCapturedAt          DateTime?     @map("gps_captured_at")
  registeredByUserId     String?       @map("registered_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner       Owner                @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  inspections VehicleInspection[]
  assignments VehicleAssignment[]
  documents     Document[]
  licences      TransportLicence[]
  fieldReceipts FieldReceipt[]
  fieldInspections FieldInspection[] @relation("VehicleFieldInspections")

  @@index([plateNumber])
  @@index([chassisVin])
  @@index([atrNumber])
  @@index([aotucLicenseNumber])
  @@index([status])
  @@index([ownerId])
  @@map("vehicles")
}

model VehicleInspection {
  id                 String   @id @default(uuid())
  vehicleId          String   @map("vehicle_id")
  certificateNumber  String   @unique @map("certificate_number")
  inspectionCenter   String   @map("inspection_center")
  inspectionDate     DateTime @map("inspection_date")
  expirationDate     DateTime @map("expiration_date")
  isConform          Boolean  @default(true) @map("is_conform")
  remarks            String?
  inspectionDocId    String?  @map("inspection_doc_id")
  createdAt          DateTime @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([expirationDate])
  @@map("vehicle_inspections")
}

model VehicleAssignment {
  id              String    @id @default(uuid())
  vehicleId       String    @map("vehicle_id")
  driverId        String    @map("driver_id")
  transportLineId String?   @map("transport_line_id")
  startDate       DateTime  @default(now()) @map("start_date")
  endDate         DateTime? @map("end_date")
  isActive        Boolean   @default(true) @map("is_active")
  assignedBy      String    @map("assigned_by")
  createdAt       DateTime  @default(now()) @map("created_at")

  vehicle       Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver        Driver         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  assignedUser  User           @relation("AssignedByUser", fields: [assignedBy], references: [id], onDelete: Restrict)
  transportLine TransportLine? @relation(fields: [transportLineId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([driverId])
  @@index([transportLineId])
  @@index([isActive])
  @@map("vehicle_assignments")
}

// ==============================================================================
// 9. TRANSPORT UNIONS (Module 2)
// ==============================================================================

enum UnionStatus {
  ACTIF
  SUSPENDU
  EN_ATTENTE_VALIDATION
  REJETE
}

model TransportUnion {
  id                  String      @id @default(uuid())
  code                String      @unique // e.g., "FNTG", "USTG"
  name                String      @unique
  registrationNumber  String?     @unique @map("registration_number") // Numéro d'agrément / récépissé
  presidentName       String?     @map("president_name")
  fonction            String?     @map("fonction") // Official position (Président, Vice-président, Secrétaire général, etc.)
  contactPhone        String?     @map("contact_phone")
  contactEmail        String?     @map("contact_email")
  headquartersAddress String?     @map("headquarters_address")
  logoUrl             String?     @map("logo_url")
  photoUrl            String?     @map("photo_url") // Representative portrait photo
  cniNumber           String?     @map("cni_number") // National Identity Card number
  status              UnionStatus @default(ACTIF)

  communeId String?  @map("commune_id")
  commune   Commune? @relation(fields: [communeId], references: [id], onDelete: SetNull)

  // Field Registration GPS & Provenance
  latitude           Float?
  longitude          Float?
  gpsCapturedAt      DateTime? @map("gps_captured_at")
  registeredByUserId String?   @map("registered_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members   Driver[]
  owners    Owner[]
  users     User[]
  documents Document[] @relation("UnionDocuments")

  @@index([status])
  @@index([code])
  @@map("transport_unions")
}

// ==============================================================================
// 9B. ADMINISTRATIVE AUTHORITIES & INSTITUTIONS
// ==============================================================================

enum AuthorityStatus {
  ACTIF
  EN_ATTENTE_VALIDATION
  SUSPENDU
  INACTIF
}

model Authority {
  id                 String          @id @default(uuid())
  fullName           String          @map("full_name")
  fonction           String          @map("fonction") // Official position (e.g. Commissaire Central, Maire, Directeur National, Commandant)
  institution        String          @map("institution") // Institution or service (e.g. Police Nationale, Gendarmerie Routière, Mairie, Ministère des Transports)
  service            String?         @map("service") // Specific service/department
  phoneNumber        String?         @map("phone_number")
  email              String?         @map("email")
  cniNumber          String?         @map("cni_number") // National Identity Card number
  badgeNumber        String?         @map("badge_number") // Official matricule / badge number
  photoUrl           String?         @map("photo_url") // Profile / portrait photo
  status             AuthorityStatus @default(ACTIF)
  notes              String?         @map("notes")

  communeId          String?         @map("commune_id")
  commune            Commune?        @relation(fields: [communeId], references: [id], onDelete: SetNull)

  registeredByUserId String?         @map("registered_by_user_id")
  registeredByUser   User?           @relation("RegisteredAuthorities", fields: [registeredByUserId], references: [id], onDelete: SetNull)

  documents          Document[]      @relation("AuthorityDocuments")

  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  @@index([status])
  @@index([institution])
  @@index([communeId])
  @@map("authorities")
}

// ==============================================================================
// 10. DOCUMENT & MEDIA SECURE STORAGE (Module 9)
// ==============================================================================

enum DocumentCategory {
  PHOTO_PORTRAIT
  CNI_RECTO
  CNI_VERSO
  PERMIS_CONDUIRE
  PERMIS_CONDUIRE_RECTO
  PERMIS_CONDUIRE_VERSO
  CARTE_GRISE
  VISITE_TECHNIQUE
  PHOTO_VEHICULE_AVANT
  PHOTO_VEHICULE_ARRIERE
  PHOTO_VEHICULE_GAUCHE
  PHOTO_VEHICULE_DROITE
  ATTESTATION_SYNDICALE
  AUTRE
}

model Document {
  id             String           @id @default(uuid())
  fileName       String           @map("file_name") // Safe server filename (UUID based)
  originalName   String           @map("original_name")
  mimeType       String           @map("mime_type")
  fileSizeBytes  Int              @map("file_size_bytes")
  storagePath    String           @map("storage_path") // Path outside public web root
  fileHashSha256 String           @map("file_hash_sha256") // Integrity hash
  category       DocumentCategory

  uploadedByUserId String @map("uploaded_by_user_id")
  uploadedByUser   User   @relation("UploadedByUser", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  personId  String?  @map("person_id")
  person    Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)

  vehicleId String?  @map("vehicle_id")
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  unionId   String?         @map("union_id")
  union     TransportUnion? @relation("UnionDocuments", fields: [unionId], references: [id], onDelete: SetNull)

  authorityId String?    @map("authority_id")
  authority   Authority? @relation("AuthorityDocuments", fields: [authorityId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([uploadedByUserId])
  @@index([personId])
  @@index([vehicleId])
  @@index([unionId])
  @@index([authorityId])
  @@index([category])
  @@map("documents")
}

// ==============================================================================
// 11. MULTI-LEVEL VALIDATION STATE MACHINE (Module 4)
// ==============================================================================

enum ValidationEntityType {
  DRIVER_ENROLMENT
  VEHICLE_ENROLMENT
  OWNER_ENROLMENT
}

enum ValidationStatus {
  BROUILLON
  SOUMIS_NIVEAU2
  EN_ATTENTE_NIVEAU3
  RETOURNE_POUR_CORRECTION
  VALIDE
  REJETE
}

enum ValidationAction {
  SUBMIT
  FORWARD_TO_L3
  RETURN_FOR_CORRECTION
  APPROVE_FINAL
  REJECT
}

model ValidationRequest {
  id              String               @id @default(uuid())
  requestNumber   String               @unique @map("request_number") // e.g. "VAL-2026-00001"
  entityType      ValidationEntityType @map("entity_type")
  targetEntityId  String               @map("target_entity_id")
  submitterId     String               @map("submitter_id")
  currentLevel    Int                  @default(1) @map("current_level")
  currentStatus   ValidationStatus     @default(BROUILLON) @map("current_status")
  communeId       String?              @map("commune_id")
  submittedAt     DateTime?            @map("submitted_at")
  finalDecisionAt DateTime?            @map("final_decision_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  submitter User             @relation("SubmittedValidationRequests", fields: [submitterId], references: [id], onDelete: Restrict)
  commune   Commune?         @relation(fields: [communeId], references: [id], onDelete: SetNull)
  steps     ValidationStep[]

  @@index([targetEntityId])
  @@index([submitterId])
  @@index([communeId])
  @@index([currentStatus])
  @@index([currentLevel])
  @@map("validation_requests")
}

model ValidationStep {
  id                  String           @id @default(uuid())
  validationRequestId String           @map("validation_request_id")
  level               Int              // 1, 2, or 3
  reviewerId          String           @map("reviewer_id")
  action              ValidationAction
  previousStatus      ValidationStatus @map("previous_status")
  newStatus           ValidationStatus @map("new_status")
  comment             String?
  decidedAt           DateTime         @default(now()) @map("decided_at")

  validationRequest ValidationRequest @relation(fields: [validationRequestId], references: [id], onDelete: Cascade)
  reviewer          User              @relation("ReviewerValidationSteps", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([validationRequestId])
  @@index([reviewerId])
  @@index([level])
  @@map("validation_steps")
}

// ==============================================================================
// 12. CREDENTIALS, BADGES & LICENCES (Modules 5 & 12)
// ==============================================================================

enum CredentialStatus {
  ACTIF
  SUSPENDU
  EXPIRE
  PERDU
  REMPLACE
  REVOQUE
}

enum CredentialType {
  DRIVER_BADGE
  TRANSPORT_LICENCE
}

model DriverBadge {
  id               String           @id @default(uuid())
  driverId         String           @map("driver_id")
  badgeNumber      String           @unique @map("badge_number") // e.g. "CH-2026-00001"
  qrPayload        String           @map("qr_payload") // Compact serialized payload
  signature        String           // Ed25519 signature (base64url)
  keyId            String           @map("key_id") // Key identifier for rotation
  issuedAt         DateTime         @default(now()) @map("issued_at")
  expiresAt        DateTime         @map("expires_at")
  status           CredentialStatus @default(ACTIF)
  suspendedAt      DateTime?        @map("suspended_at")
  suspensionReason String?          @map("suspension_reason")
  replacesBadgeId  String?          @map("replaces_badge_id")
  printedAt        DateTime?        @map("printed_at")
  printCount       Int              @default(0) @map("print_count")
  isPaymentConfirmed Boolean        @default(true) @map("is_payment_confirmed")
  paymentReference   String?        @map("payment_reference")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([badgeNumber])
  @@index([status])
  @@index([expiresAt])
  @@map("driver_badges")
}

model TransportLicence {
  id                String           @id @default(uuid())
  vehicleId         String           @map("vehicle_id")
  transportLineCode String?          @map("transport_line_code") // e.g. "L-01"
  licenceNumber     String           @unique @map("licence_number") // e.g. "LIC-2026-00001"
  qrPayload         String           @map("qr_payload")
  signature         String           // Ed25519 signature (base64url)
  keyId             String           @map("key_id")
  issuedAt          DateTime         @default(now()) @map("issued_at")
  expiresAt         DateTime         @map("expires_at")
  status            CredentialStatus @default(ACTIF)
  suspendedAt       DateTime?        @map("suspended_at")
  suspensionReason  String?          @map("suspension_reason")
  replacesLicenceId     String?          @map("replaces_licence_id")
  printedAt             DateTime?        @map("printed_at")
  printCount            Int              @default(0) @map("print_count")
  isPaymentConfirmed    Boolean          @default(true) @map("is_payment_confirmed")
  superAdminConfirmedAt DateTime?        @map("super_admin_confirmed_at")
  superAdminUserId      String?          @map("super_admin_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([licenceNumber])
  @@index([status])
  @@index([expiresAt])
  @@map("transport_licences")
}

model CredentialRevocation {
  id              String         @id @default(uuid())
  credentialType  CredentialType @map("credential_type")
  credentialId    String         @map("credential_id") // Badge or Licence UUID
  serialNumber    String         @map("serial_number") // CH-2026-00001 or LIC-2026-00001
  revokedAt       DateTime       @default(now()) @map("revoked_at")
  revokedByUserId String         @map("revoked_by_user_id")
  reason          String
  isPermanent     Boolean        @default(true) @map("is_permanent")

  @@index([credentialId])
  @@index([serialNumber])
  @@index([credentialType])
  @@index([revokedAt])
  @@map("credential_revocations")
}

// ==============================================================================
// 13. GIS, TRANSPORT LINES & BUS STOPS (Modules 6 & 7)
// ==============================================================================

enum StopDirection {
  ALLER
  RETOUR
  CIRCULAIRE
}

model TransportLine {
  id               String   @id @default(uuid())
  code             String   @unique // e.g. "L-01", "L-02", "L-03"
  name             String   // e.g. "Kaloum (Port) — Matoto (Rond-point)"
  colorHex         String   @default("#2563EB") @map("color_hex") // Route color e.g. #2563EB, #DC2626
  description      String?
  originName       String   @map("origin_name")
  destinationName  String   @map("destination_name")
  distanceKm       Float?   @map("distance_km")
  estimatedMinutes Int?     @map("estimated_minutes")
  isActive         Boolean  @default(true) @map("is_active")
  pathCoordinates  Json?    @map("path_coordinates") // GeoJSON LineString coordinates [[lng, lat], ...]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stops       LineStop[]
  assignments VehicleAssignment[]

  @@index([code])
  @@index([isActive])
  @@map("transport_lines")
}

model TransportStop {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. "ARR-KLM-01"
  name        String   // e.g. "Gare Centrale de Kaloum", "Madina Marché"
  communeId   String?  @map("commune_id")
  latitude    Float
  longitude   Float
  isSheltered Boolean  @default(false) @map("is_sheltered")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  commune Commune?   @relation(fields: [communeId], references: [id], onDelete: SetNull)
  lines   LineStop[]

  @@index([code])
  @@index([communeId])
  @@map("transport_stops")
}

model LineStop {
  id                  String        @id @default(uuid())
  lineId              String        @map("line_id")
  stopId              String        @map("stop_id")
  stopOrder           Int           @map("stop_order") // 1, 2, 3...
  direction           StopDirection @default(ALLER)
  distanceFromStartKm Float?        @map("distance_from_start_km")

  createdAt DateTime @default(now()) @map("created_at")

  line TransportLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  stop TransportStop @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@unique([lineId, stopId, direction])
  @@index([lineId])
  @@index([stopId])
  @@index([stopOrder])
  @@map("line_stops")
}

// ==============================================================================
// 14. TICKETING & DOUBLE-ENTRY IMMUTABLE FINANCIAL LEDGER (GNF)
// ==============================================================================

enum TicketBatchStatus {
  EN_STOCK_CENTRAL
  ALLOUE_DISTRIBUTEUR
  EPUISE
  ANNULE
}

enum PaymentMethod {
  ESPECES
  ORANGE_MONEY
  MTN_MOMO
  VIREMENT_BANCAIRE
}

enum FinancialAccountType {
  ACTIF
  PASSIF
  PRODUIT
  CHARGE
}

enum LedgerTransactionType {
  ALLOCATION_DISTRIBUTEUR
  VENTE_TICKETS_DIRECTE
  ENCAISSEMENT_MOBILE_MONEY
  VERSEMENT_BANQUE_BCRG
  REGULARISATION_COMPTABLE
}

model TicketTariff {
  id              String   @id @default(uuid())
  code            String   @unique // e.g. "T-2000", "T-5000", "T-10000"
  name            String   // e.g. "Ticket Standard Urbain 2 000 GNF"
  priceGnf        Int      // In Guinean Francs (GNF)
  vehicleCategory String?  @map("vehicle_category") // TAXI_COMMUNAL, MINIBUS_URBAIN...
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  batches TicketBatch[]
  sales   TicketSale[]

  @@map("ticket_tariffs")
}

model TicketBatch {
  id                String            @id @default(uuid())
  batchNumber       String            @unique @map("batch_number") // e.g. "LOT-2026-0001"
  tariffId          String            @map("tariff_id")
  startSerial       BigInt            @map("start_serial") // e.g. 1000001
  endSerial         BigInt            @map("end_serial")   // e.g. 1000100 (Carnet de 100)
  totalCount        Int               @map("total_count")
  remainingCount    Int               @map("remaining_count")
  status            TicketBatchStatus @default(EN_STOCK_CENTRAL)
  allocatedToUserId String?           @map("allocated_to_user_id")
  allocatedAt       DateTime?         @map("allocated_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  tariff          TicketTariff @relation(fields: [tariffId], references: [id])
  allocatedToUser User?        @relation(fields: [allocatedToUserId], references: [id])
  sales           TicketSale[]

  @@index([batchNumber])
  @@index([status])
  @@index([allocatedToUserId])
  @@map("ticket_batches")
}

model TicketSale {
  id              String        @id @default(uuid())
  receiptNumber   String        @unique @map("receipt_number") // e.g. "REC-2026-00042"
  tariffId        String        @map("tariff_id")
  batchId         String        @map("batch_id")
  sellerUserId    String        @map("seller_user_id") // Agent or Distributeur
  quantitySold    Int           @map("quantity_sold")
  unitPriceGnf    Int           @map("unit_price_gnf")
  totalAmountGnf  BigInt        @map("total_amount_gnf") // quantity * unitPrice
  paymentMethod   PaymentMethod @default(ESPECES) @map("payment_method")
  paymentRef      String?       @map("payment_ref") // Orange Money / MTN MoMo Transaction ID
  buyerName       String?       @map("buyer_name")
  buyerPhone      String?       @map("buyer_phone")
  saleTimestamp   DateTime      @default(now()) @map("sale_timestamp")

  tariff     TicketTariff @relation(fields: [tariffId], references: [id])
  batch      TicketBatch  @relation(fields: [batchId], references: [id])
  sellerUser User         @relation(fields: [sellerUserId], references: [id])

  @@index([receiptNumber])
  @@index([sellerUserId])
  @@index([saleTimestamp])
  @@map("ticket_sales")
}

model FinancialAccount {
  id          String               @id @default(uuid())
  accountCode String               @unique @map("account_code") // e.g. "512100", "531100", "706100"
  name        String               // e.g. "Banque Centrale (BCRG)", "Caisse Principale AOTUC"
  type        FinancialAccountType
  balanceGnf  BigInt               @default(0) @map("balance_gnf")
  currency    String               @default("GNF")
  isActive    Boolean              @default(true) @map("is_active")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  debitEntries  FinancialLedgerEntry[] @relation("DebitAccount")
  creditEntries FinancialLedgerEntry[] @relation("CreditAccount")

  @@map("financial_accounts")
}

model FinancialLedgerEntry {
  id              String                @id @default(uuid())
  entryNumber     String                @unique @map("entry_number") // Sequential unique: "JNL-2026-000001"
  debitAccountId  String                @map("debit_account_id")
  creditAccountId String                @map("credit_account_id")
  amountGnf       BigInt                @map("amount_gnf") // Strictly positive double-entry balance
  transactionType LedgerTransactionType @map("transaction_type")
  referenceCode   String                @map("reference_code") // Sale receipt, batch allocation ID, or bank deposit
  description     String
  actorUserId     String                @map("actor_user_id")
  createdAt       DateTime              @default(now()) @map("created_at") // IMMUTABLE

  debitAccount  FinancialAccount @relation("DebitAccount", fields: [debitAccountId], references: [id])
  creditAccount FinancialAccount @relation("CreditAccount", fields: [creditAccountId], references: [id])
  actorUser     User             @relation(fields: [actorUserId], references: [id])

  @@index([entryNumber])
  @@index([debitAccountId])
  @@index([creditAccountId])
  @@index([createdAt])
  @@map("financial_ledger_entries")
}

// ==============================================================================
// 15. FIELD OPERATIONS, ASSIGNMENTS & PROOF OF WORK (Phase 6)
// ==============================================================================

enum FieldAssignmentStatus {
  DRAFT
  PLANNED
  ASSIGNED
  IN_PROGRESS
  AWAITING_REPORT
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

model FieldTeam {
  id        String   @id @default(uuid())
  code      String   @unique // e.g. "EQ-KLM-01", "EQ-MTT-02"
  name      String   // e.g. "Équipe Mobile Kaloum Port", "Brigade Enrôlement Matoto"
  communeId String?  @map("commune_id")
  leaderId  String?  @map("leader_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  commune     Commune?          @relation(fields: [communeId], references: [id], onDelete: SetNull)
  leader      User?             @relation("LeaderFieldTeams", fields: [leaderId], references: [id], onDelete: SetNull)
  assignments FieldAssignment[]
  members     User[]            @relation("TeamMembers")

  @@index([communeId])
  @@index([leaderId])
  @@map("field_teams")
}

model FieldAssignment {
  id              String                @id @default(uuid())
  reference       String                @unique // e.g. "ASN-2026-00001"
  title           String                // e.g. "Campagne Enrôlement Gare Centrale Kaloum"
  communeId       String                @map("commune_id")
  locationName    String                @map("location_name") // Location, station, parking area, pickup point
  latitude        Float?
  longitude       Float?
  assignedUserId  String?               @map("assigned_user_id")
  teamId          String?               @map("team_id")
  supervisorId    String                @map("supervisor_id")
  startDate       DateTime              @map("start_date")
  endDate         DateTime?             @map("end_date")
  targetPeople    Int                   @default(0) @map("target_people")
  targetVehicles  Int                   @default(0) @map("target_vehicles")
  instructions    String?
  supervisorNotes String?               @map("supervisor_notes")
  status          FieldAssignmentStatus @default(PLANNED)
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  commune      Commune        @relation(fields: [communeId], references: [id], onDelete: Restrict)
  assignedUser User?          @relation("AssignedFieldAssignments", fields: [assignedUserId], references: [id], onDelete: SetNull)
  team         FieldTeam?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  supervisor   User           @relation("SupervisedFieldAssignments", fields: [supervisorId], references: [id], onDelete: Restrict)
  receipts     FieldReceipt[]
  objectives          String?
  inspectionTargets   Json?                 @map("inspection_targets")
  cancellationReason  String?               @map("cancellation_reason")
  cancelledAt         DateTime?             @map("cancelled_at")
  cancelledByUserId   String?               @map("cancelled_by_user_id")

  cancelledByUser     User?                 @relation("CancelledFieldAssignments", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  assignedAgents      FieldAssignmentAgent[]
  inspections         FieldInspection[]
  missionReport       MissionReport?

  @@index([communeId])
  @@index([assignedUserId])
  @@index([teamId])
  @@index([supervisorId])
  @@index([status])
  @@index([startDate])
  @@map("field_assignments")
}

model FieldReceipt {
  id            String           @id @default(uuid())
  receiptNumber String           @unique @map("receipt_number") // Unique ref e.g. "REC-FLD-2026-00001"
  assignmentId  String?          @map("assignment_id")
  agentUserId   String           @map("agent_user_id")
  personId      String?          @map("person_id")
  vehicleId     String?          @map("vehicle_id")
  communeId     String?          @map("commune_id")
  latitude      Float?
  longitude     Float?
  notes         String?
  issuedAt      DateTime         @default(now()) @map("issued_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  assignment FieldAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  agentUser  User             @relation("AgentFieldReceipts", fields: [agentUserId], references: [id], onDelete: Restrict)
  person     Person?          @relation(fields: [personId], references: [id], onDelete: SetNull)
  vehicle    Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  commune    Commune?         @relation(fields: [communeId], references: [id], onDelete: SetNull)

  @@index([assignmentId])
  @@index([agentUserId])
  @@index([personId])
  @@index([vehicleId])
  @@index([communeId])
  @@index([receiptNumber])
  @@index([issuedAt])
  @@map("field_receipts")
}

// ==============================================================================
// 16. FIELD INSPECTIONS, MULTI-AGENT MISSIONS & MISSION REPORTS
// ==============================================================================

enum CheckpointStatus {
  YES
  NO
  NOT_CHECKED
}

enum InspectionOutcome {
  NOT_ASSESSED
  CONFORME
  NON_CONFORME
  AVERTISSEMENT
  INFRACTION
}

enum MissionReportStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

enum MissionReportDecision {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

model FieldAssignmentAgent {
  id            String          @id @default(uuid())
  assignmentId  String          @map("assignment_id")
  agentUserId   String          @map("agent_user_id")
  roleInMission String          @default("MEMBER") @map("role_in_mission") // "LEAD" | "MEMBER"
  assignedAt    DateTime        @default(now()) @map("assigned_at")

  assignment    FieldAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  agentUser     User            @relation("AssignedMissionAgents", fields: [agentUserId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, agentUserId])
  @@index([assignmentId])
  @@index([agentUserId])
  @@map("field_assignment_agents")
}

model FieldInspection {
  id                  String            @id @default(uuid())
  reference           String            @unique // e.g. "INS-2026-00001-A1B2"
  assignmentId        String            @map("assignment_id")
  agentUserId         String            @map("agent_user_id")
  communeId           String            @map("commune_id")

  // Optional References to Registered Entities
  driverId            String?           @map("driver_id")
  vehicleId           String?           @map("vehicle_id")
  personId            String?           @map("person_id")

  // Historical Snapshot Information (Preserved across subsequent entity modifications)
  targetType          String            @map("target_type") // "DRIVER", "VEHICLE", "COMMERCIAL_TRANSPORT"
  driverName          String?           @map("driver_name")
  driverPhone         String?           @map("driver_phone")
  licenseNumber       String?           @map("license_number")
  plateNumber         String?           @map("plate_number")
  vehicleType         String?           @map("vehicle_type")

  // Explicit Three-State Checkpoints (Defaults strictly to NOT_CHECKED)
  hasValidLicense     CheckpointStatus  @default(NOT_CHECKED) @map("has_valid_license")
  hasMunicipalSticker CheckpointStatus  @default(NOT_CHECKED) @map("has_municipal_sticker")
  hasTechnicalControl CheckpointStatus  @default(NOT_CHECKED) @map("has_technical_control")
  isAuthorizedRoute   CheckpointStatus  @default(NOT_CHECKED) @map("is_authorized_route")
  hasSafetyEquipment  CheckpointStatus  @default(NOT_CHECKED) @map("has_safety_equipment")

  // Outcome & Infractions (Defaults strictly to NOT_ASSESSED)
  outcome             InspectionOutcome @default(NOT_ASSESSED)
  violations          Json?             // Array of infraction strings/codes
  observations        String?

  // Geographical & Temporal Traceability
  latitude            Float?
  longitude           Float?
  locationName        String?           @map("location_name")
  inspectedAt         DateTime          @default(now()) @map("inspected_at")
  createdAt           DateTime          @default(now()) @map("created_at")

  // Strict Physical Isolation from Administrative Validation
  assignment          FieldAssignment   @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  agentUser           User              @relation("AgentFieldInspections", fields: [agentUserId], references: [id], onDelete: Restrict)
  commune             Commune           @relation("CommuneFieldInspections", fields: [communeId], references: [id], onDelete: Restrict)
  driver              Driver?           @relation("DriverFieldInspections", fields: [driverId], references: [id], onDelete: SetNull)
  vehicle             Vehicle?          @relation("VehicleFieldInspections", fields: [vehicleId], references: [id], onDelete: SetNull)
  person              Person?           @relation("PersonFieldInspections", fields: [personId], references: [id], onDelete: SetNull)
  documents           InspectionDocument[]

  @@index([assignmentId])
  @@index([agentUserId])
  @@index([communeId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([personId])
  @@index([plateNumber])
  @@index([licenseNumber])
  @@index([outcome])
  @@map("field_inspections")
}

model InspectionDocument {
  id           String          @id @default(uuid())
  inspectionId String          @map("inspection_id")
  category     String          // "VEHICLE_PHOTO", "VIOLATION_EVIDENCE", "DOCUMENT_SCAN"
  fileUrl      String          @map("file_url")
  fileHash     String?         @map("file_hash")
  mimeType     String          @map("mime_type")
  createdAt    DateTime        @default(now()) @map("created_at")

  inspection   FieldInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@map("inspection_documents")
}

model MissionReport {
  id                  String              @id @default(uuid())
  reference           String              @unique // e.g. "RAP-2026-00001"
  assignmentId        String              @unique @map("assignment_id") // One shared report per mission
  leadAuthorId        String              @map("lead_author_id")
  currentVersion      Int                 @default(1) @map("current_version")
  status              MissionReportStatus @default(DRAFT)

  // Current Active Content
  objectivesAssessed  String?             @map("objectives_assessed")
  summary             String              // Executive summary of operations
  inspectionsCount    Int                 @default(0) @map("inspections_count")
  violationsCount     Int                 @default(0) @map("violations_count")
  observations        String?
  recommendations     String?
  conclusions         String?
  contributors        Json?               // Structured list of contributing agents
  evidencePhotos      Json?               @map("evidence_photos") // Array of evidence photo URLs/hashes

  // Review & Approval Lifecycle
  supervisorNotes     String?             @map("supervisor_notes")
  reviewedByUserId    String?             @map("reviewed_by_user_id")
  reviewedAt          DateTime?           @map("reviewed_at")
  submittedAt         DateTime?           @map("submitted_at")

  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  assignment          FieldAssignment     @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  leadAuthor          User                @relation("LeadAuthorMissionReports", fields: [leadAuthorId], references: [id], onDelete: Restrict)
  reviewedByUser      User?               @relation("ReviewedMissionReports", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  versions            MissionReportVersion[]

  @@index([assignmentId])
  @@index([leadAuthorId])
  @@index([status])
  @@map("mission_reports")
}

model MissionReportVersion {
  id                 String                 @id @default(uuid())
  reportId           String                 @map("report_id")
  versionNumber      Int                    @map("version_number")

  // Immutable Historical Snapshot of Content at Submission
  summary            String
  objectivesAssessed String?                @map("objectives_assessed")
  inspectionsCount   Int                    @map("inspections_count")
  violationsCount    Int                    @map("violations_count")
  observations       String?
  recommendations    String?
  conclusions        String?
  contributors       Json?
  evidencePhotos     Json?                  @map("evidence_photos")

  // Submission Traceability
  submittedByUserId  String                 @map("submitted_by_user_id")
  submittedAt        DateTime               @default(now()) @map("submitted_at")

  // Review & Decision Snapshot (Dedicated Enum: APPROVED | REJECTED | CHANGES_REQUESTED)
  reviewedByUserId   String?                @map("reviewed_by_user_id")
  decision           MissionReportDecision?
  supervisorComments String?                @map("supervisor_comments")
  decisionAt         DateTime?              @map("decision_at")

  report             MissionReport          @relation(fields: [reportId], references: [id], onDelete: Restrict)
  submittedByUser    User                   @relation("SubmittedReportVersions", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  reviewedByUser     User?                  @relation("ReviewedReportVersions", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([reportId, versionNumber])
  @@index([reportId])
  @@index([submittedByUserId])
  @@map("mission_report_versions")
}
