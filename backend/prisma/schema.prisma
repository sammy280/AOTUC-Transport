// AOTUC-TRANSPORT v2.0 — Prisma Database Schema
// Database: PostgreSQL 18 with PostGIS

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ==============================================================================
// 1. ORGANIZATIONAL SCOPE & ADMINISTRATIVE DIVISIONS
// ==============================================================================

model Commune {
  id          String   @id @default(uuid())
  code        String   @unique // e.g., "KLM", "DXN", "MTM", "RTM", "MTT"
  name        String   @unique // e.g., "Kaloum", "Dixinn", "Matam", "Ratoma", "Matoto"
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("communes")
}

// ==============================================================================
// 2. USERS, ROLES, AND AUTHENTICATION
// ==============================================================================

enum RoleType {
  SUPER_ADMIN
  DIRECTOR
  CHEF_SERVICE
  AGENT_TERRAIN
  SYNDICAT
  DISTRIBUTEUR
}

model Role {
  id          String    @id @default(uuid())
  name        RoleType  @unique
  labelFr     String    @map("label_fr") // Human readable French label
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")

  userRoles UserRole[]

  @@map("roles")
}

model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  phoneNumber  String   @unique @map("phone_number")
  passwordHash String   @map("password_hash")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  isActive     Boolean  @default(true) @map("is_active")
  
  // Territorial / Departmental Scope
  communeId    String?  @map("commune_id")
  commune      Commune? @relation(fields: [communeId], references: [id], onDelete: SetNull)

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  roles         UserRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]     @relation("ActorAuditLogs")

  @@index([phoneNumber])
  @@index([email])
  @@index([communeId])
  @@map("users")
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

// ==============================================================================
// 3. REFRESH TOKEN ROTATION & SESSION INTEGRITY
// ==============================================================================

model RefreshToken {
  id               String   @id @default(uuid())
  tokenHash        String   @unique @map("token_hash")
  userId           String   @map("user_id")
  family           String   // UUID representing token issuance lineage for reuse detection
  isRevoked        Boolean  @default(false) @map("is_revoked")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  replacedByToken  String?  @map("replaced_by_token")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

// ==============================================================================
// 4. AUDIT LOGGING & COMPLIANCE
// ==============================================================================

model AuditLog {
  id             String   @id @default(uuid())
  actorId        String?  @map("actor_id")
  action         String   // e.g., "USER_LOGIN", "ROLE_ASSIGNED", "PASSWORD_CHANGED"
  targetModule   String   @map("target_module") // e.g., "AUTH", "USERS", "VALIDATION"
  targetRecordId String?  @map("target_record_id")
  previousValues Json?    @map("previous_values")
  newValues      Json?    @map("new_values")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  reason         String?
  timestamp      DateTime @default(now())

  actor User? @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([targetModule])
  @@index([timestamp])
  @@map("audit_logs")
}
