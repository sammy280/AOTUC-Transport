// AOTUC-TRANSPORT v2.0 — Prisma Database Schema
// Database: PostgreSQL 18 with PostGIS

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ==============================================================================
// 1. ORGANIZATIONAL SCOPE & ADMINISTRATIVE DIVISIONS
// ==============================================================================

model Commune {
  id          String   @id @default(uuid())
  code        String   @unique // e.g., "KLM", "DXN", "MTM", "RTM", "MTT"
  name        String   @unique // e.g., "Kaloum", "Dixinn", "Matam", "Ratoma", "Matoto"
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users              User[]
  persons            Person[]
  unions             TransportUnion[]
  validationRequests ValidationRequest[]
  stops              TransportStop[]

  @@map("communes")
}

// ==============================================================================
// 2. USERS, ROLES, AND AUTHENTICATION
// ==============================================================================

enum RoleType {
  SUPER_ADMIN
  DIRECTOR
  CHEF_SERVICE
  AGENT_TERRAIN
  SYNDICAT
  DISTRIBUTEUR
}

model Role {
  id          String   @id @default(uuid())
  name        RoleType @unique
  labelFr     String   @map("label_fr") // Human readable French label
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  userRoles UserRole[]

  @@map("roles")
}

model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  phoneNumber  String   @unique @map("phone_number")
  passwordHash String   @map("password_hash")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  isActive     Boolean  @default(true) @map("is_active")

  // Territorial / Departmental Scope
  communeId String?  @map("commune_id")
  commune   Commune? @relation(fields: [communeId], references: [id], onDelete: SetNull)

  // Union Scope (for SYNDICAT role users)
  unionId String?         @map("union_id")
  union   TransportUnion? @relation(fields: [unionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  roles                       UserRole[]
  refreshTokens               RefreshToken[]
  auditLogs                   AuditLog[]            @relation("ActorAuditLogs")
  uploadedDocuments           Document[]            @relation("UploadedByUser")
  vehicleAssignments          VehicleAssignment[]   @relation("AssignedByUser")
  submittedValidationRequests ValidationRequest[]   @relation("SubmittedValidationRequests")
  reviewedValidationSteps     ValidationStep[]      @relation("ReviewerValidationSteps")
  allocatedTicketBatches      TicketBatch[]
  recordedTicketSales         TicketSale[]
  recordedLedgerEntries       FinancialLedgerEntry[]

  @@index([phoneNumber])
  @@index([email])
  @@index([communeId])
  @@index([unionId])
  @@map("users")
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

// ==============================================================================
// 3. REFRESH TOKEN ROTATION & SESSION INTEGRITY
// ==============================================================================

model RefreshToken {
  id              String   @id @default(uuid())
  tokenHash       String   @unique @map("token_hash")
  userId          String   @map("user_id")
  family          String // UUID representing token issuance lineage for reuse detection
  isRevoked       Boolean  @default(false) @map("is_revoked")
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")
  replacedByToken String?  @map("replaced_by_token")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

// ==============================================================================
// 4. AUDIT LOGGING & COMPLIANCE
// ==============================================================================

model AuditLog {
  id             String   @id @default(uuid())
  actorId        String?  @map("actor_id")
  action         String // e.g., "USER_LOGIN", "DRIVER_ENROLLED", "DOCUMENT_UPLOADED"
  targetModule   String   @map("target_module") // e.g., "AUTH", "REGISTRATION", "DOCUMENTS"
  targetRecordId String?  @map("target_record_id")
  previousValues Json?    @map("previous_values")
  newValues      Json?    @map("new_values")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  reason         String?
  timestamp      DateTime @default(now())

  actor User? @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([targetModule])
  @@index([timestamp])
  @@map("audit_logs")
}

// ==============================================================================
// 5. PERSON IDENTITY REGISTRY (Module 2)
// ==============================================================================

model Person {
  id          String    @id @default(uuid())
  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  nin         String    @unique // Guinean National Identification Number (NIN)
  phoneNumber String    @unique @map("phone_number") // Normalized E.164 (+224...)
  email       String?
  dateOfBirth DateTime? @map("date_of_birth")
  address     String?

  communeId String?  @map("commune_id")
  commune   Commune? @relation(fields: [communeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  driver    Driver?
  owner     Owner?
  documents Document[]

  @@index([nin])
  @@index([phoneNumber])
  @@index([communeId])
  @@map("persons")
}

// ==============================================================================
// 6. DRIVERS & LICENCES (Module 2)
// ==============================================================================

enum DriverStatus {
  BROUILLON
  EN_ATTENTE_VALIDATION
  ACTIF
  SUSPENDU
  INACTIF
}

model Driver {
  id                    String       @id @default(uuid())
  personId              String       @unique @map("person_id")
  drivingLicenseNumber  String       @unique @map("driving_license_number")
  licenseCategory       String       @default("B") @map("license_category") // e.g., "B", "C", "D"
  licenseExpirationDate DateTime     @map("license_expiration_date")
  status                DriverStatus @default(EN_ATTENTE_VALIDATION)

  unionId String?         @map("union_id")
  union   TransportUnion? @relation(fields: [unionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  person      Person              @relation(fields: [personId], references: [id], onDelete: Restrict)
  assignments VehicleAssignment[]
  badges      DriverBadge[]

  @@index([drivingLicenseNumber])
  @@index([status])
  @@index([unionId])
  @@map("drivers")
}

// ==============================================================================
// 7. VEHICLE OWNERS (Module 2)
// ==============================================================================

enum OwnerType {
  INDIVIDU
  ENTREPRISE
}

model Owner {
  id           String    @id @default(uuid())
  personId     String    @unique @map("person_id")
  ownerType    OwnerType @default(INDIVIDU) @map("owner_type")
  businessName String?   @map("business_name")
  taxNumber    String?   @map("tax_number") // Numéro d'Identification Fiscale (NIF)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  person   Person    @relation(fields: [personId], references: [id], onDelete: Restrict)
  vehicles Vehicle[]

  @@map("owners")
}

// ==============================================================================
// 8. VEHICLES & INSPECTIONS (Module 2)
// ==============================================================================

enum VehicleType {
  TAXI_COLLECTIF
  MAGBANA_MINIBUS
  BUS_URBAIN
  MOTOTAXI
  AUTRE
}

enum VehicleStatus {
  BROUILLON
  EN_ATTENTE_VALIDATION
  ACTIF
  EN_PANNE
  SUSPENDU
  RETIRE
}

model Vehicle {
  id                     String        @id @default(uuid())
  ownerId                String        @map("owner_id")
  plateNumber            String        @unique @map("plate_number") // Plaque d'immatriculation (ex: RC-1234-A)
  registrationCardNumber String        @unique @map("registration_card_number") // Numéro carte grise
  chassisVin             String        @unique @map("chassis_vin") // Numéro de châssis / VIN
  vehicleType            VehicleType   @map("vehicle_type")
  make                   String // Marque (ex: Toyota)
  model                  String // Modèle (ex: Corolla)
  year                   Int? // Année de mise en circulation
  seatingCapacity        Int?          @map("seating_capacity")
  status                 VehicleStatus @default(EN_ATTENTE_VALIDATION)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner       Owner                @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  inspections VehicleInspection[]
  assignments VehicleAssignment[]
  documents   Document[]
  licences    TransportLicence[]

  @@index([plateNumber])
  @@index([chassisVin])
  @@index([status])
  @@index([ownerId])
  @@map("vehicles")
}

model VehicleInspection {
  id                 String   @id @default(uuid())
  vehicleId          String   @map("vehicle_id")
  certificateNumber  String   @unique @map("certificate_number")
  inspectionCenter   String   @map("inspection_center")
  inspectionDate     DateTime @map("inspection_date")
  expirationDate     DateTime @map("expiration_date")
  isConform          Boolean  @default(true) @map("is_conform")
  remarks            String?
  inspectionDocId    String?  @map("inspection_doc_id")
  createdAt          DateTime @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([expirationDate])
  @@map("vehicle_inspections")
}

model VehicleAssignment {
  id              String    @id @default(uuid())
  vehicleId       String    @map("vehicle_id")
  driverId        String    @map("driver_id")
  transportLineId String?   @map("transport_line_id")
  startDate       DateTime  @default(now()) @map("start_date")
  endDate         DateTime? @map("end_date")
  isActive        Boolean   @default(true) @map("is_active")
  assignedBy      String    @map("assigned_by")
  createdAt       DateTime  @default(now()) @map("created_at")

  vehicle       Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver        Driver         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  assignedUser  User           @relation("AssignedByUser", fields: [assignedBy], references: [id], onDelete: Restrict)
  transportLine TransportLine? @relation(fields: [transportLineId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([driverId])
  @@index([transportLineId])
  @@index([isActive])
  @@map("vehicle_assignments")
}

// ==============================================================================
// 9. TRANSPORT UNIONS (Module 2)
// ==============================================================================

model TransportUnion {
  id                  String   @id @default(uuid())
  code                String   @unique // e.g., "FNTG", "USTG"
  name                String   @unique
  contactPhone        String?  @map("contact_phone")
  contactEmail        String?  @map("contact_email")
  headquartersAddress String?  @map("headquarters_address")

  communeId String?  @map("commune_id")
  commune   Commune? @relation(fields: [communeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members Driver[]
  users   User[]

  @@map("transport_unions")
}

// ==============================================================================
// 10. DOCUMENT & MEDIA SECURE STORAGE (Module 9)
// ==============================================================================

enum DocumentCategory {
  PHOTO_PORTRAIT
  CNI_RECTO
  CNI_VERSO
  PERMIS_CONDUIRE
  CARTE_GRISE
  VISITE_TECHNIQUE
  PHOTO_VEHICULE_AVANT
  PHOTO_VEHICULE_ARRIERE
  PHOTO_VEHICULE_GAUCHE
  PHOTO_VEHICULE_DROITE
  ATTESTATION_SYNDICALE
  AUTRE
}

model Document {
  id             String           @id @default(uuid())
  fileName       String           @map("file_name") // Safe server filename (UUID based)
  originalName   String           @map("original_name")
  mimeType       String           @map("mime_type")
  fileSizeBytes  Int              @map("file_size_bytes")
  storagePath    String           @map("storage_path") // Path outside public web root
  fileHashSha256 String           @map("file_hash_sha256") // Integrity hash
  category       DocumentCategory

  uploadedByUserId String @map("uploaded_by_user_id")
  uploadedByUser   User   @relation("UploadedByUser", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  personId  String?  @map("person_id")
  person    Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)

  vehicleId String?  @map("vehicle_id")
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([uploadedByUserId])
  @@index([personId])
  @@index([vehicleId])
  @@index([category])
  @@map("documents")
}

// ==============================================================================
// 11. MULTI-LEVEL VALIDATION STATE MACHINE (Module 4)
// ==============================================================================

enum ValidationEntityType {
  DRIVER_ENROLMENT
  VEHICLE_ENROLMENT
  OWNER_ENROLMENT
}

enum ValidationStatus {
  BROUILLON
  SOUMIS_NIVEAU2
  EN_ATTENTE_NIVEAU3
  RETOURNE_POUR_CORRECTION
  VALIDE
  REJETE
}

enum ValidationAction {
  SUBMIT
  FORWARD_TO_L3
  RETURN_FOR_CORRECTION
  APPROVE_FINAL
  REJECT
}

model ValidationRequest {
  id              String               @id @default(uuid())
  requestNumber   String               @unique @map("request_number") // e.g. "VAL-2026-00001"
  entityType      ValidationEntityType @map("entity_type")
  targetEntityId  String               @map("target_entity_id")
  submitterId     String               @map("submitter_id")
  currentLevel    Int                  @default(1) @map("current_level")
  currentStatus   ValidationStatus     @default(BROUILLON) @map("current_status")
  communeId       String?              @map("commune_id")
  submittedAt     DateTime?            @map("submitted_at")
  finalDecisionAt DateTime?            @map("final_decision_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  submitter User             @relation("SubmittedValidationRequests", fields: [submitterId], references: [id], onDelete: Restrict)
  commune   Commune?         @relation(fields: [communeId], references: [id], onDelete: SetNull)
  steps     ValidationStep[]

  @@index([targetEntityId])
  @@index([submitterId])
  @@index([communeId])
  @@index([currentStatus])
  @@index([currentLevel])
  @@map("validation_requests")
}

model ValidationStep {
  id                  String           @id @default(uuid())
  validationRequestId String           @map("validation_request_id")
  level               Int              // 1, 2, or 3
  reviewerId          String           @map("reviewer_id")
  action              ValidationAction
  previousStatus      ValidationStatus @map("previous_status")
  newStatus           ValidationStatus @map("new_status")
  comment             String?
  decidedAt           DateTime         @default(now()) @map("decided_at")

  validationRequest ValidationRequest @relation(fields: [validationRequestId], references: [id], onDelete: Cascade)
  reviewer          User              @relation("ReviewerValidationSteps", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([validationRequestId])
  @@index([reviewerId])
  @@index([level])
  @@map("validation_steps")
}

// ==============================================================================
// 12. CREDENTIALS, BADGES & LICENCES (Modules 5 & 12)
// ==============================================================================

enum CredentialStatus {
  ACTIF
  SUSPENDU
  EXPIRE
  PERDU
  REMPLACE
  REVOQUE
}

enum CredentialType {
  DRIVER_BADGE
  TRANSPORT_LICENCE
}

model DriverBadge {
  id               String           @id @default(uuid())
  driverId         String           @map("driver_id")
  badgeNumber      String           @unique @map("badge_number") // e.g. "CH-2026-00001"
  qrPayload        String           @map("qr_payload") // Compact serialized payload
  signature        String           // Ed25519 signature (base64url)
  keyId            String           @map("key_id") // Key identifier for rotation
  issuedAt         DateTime         @default(now()) @map("issued_at")
  expiresAt        DateTime         @map("expires_at")
  status           CredentialStatus @default(ACTIF)
  suspendedAt      DateTime?        @map("suspended_at")
  suspensionReason String?          @map("suspension_reason")
  replacesBadgeId  String?          @map("replaces_badge_id")
  printedAt        DateTime?        @map("printed_at")
  printCount       Int              @default(0) @map("print_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([badgeNumber])
  @@index([status])
  @@index([expiresAt])
  @@map("driver_badges")
}

model TransportLicence {
  id                String           @id @default(uuid())
  vehicleId         String           @map("vehicle_id")
  transportLineCode String?          @map("transport_line_code") // e.g. "L-01"
  licenceNumber     String           @unique @map("licence_number") // e.g. "LIC-2026-00001"
  qrPayload         String           @map("qr_payload")
  signature         String           // Ed25519 signature (base64url)
  keyId             String           @map("key_id")
  issuedAt          DateTime         @default(now()) @map("issued_at")
  expiresAt         DateTime         @map("expires_at")
  status            CredentialStatus @default(ACTIF)
  suspendedAt       DateTime?        @map("suspended_at")
  suspensionReason  String?          @map("suspension_reason")
  replacesLicenceId String?          @map("replaces_licence_id")
  printedAt         DateTime?        @map("printed_at")
  printCount        Int              @default(0) @map("print_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([licenceNumber])
  @@index([status])
  @@index([expiresAt])
  @@map("transport_licences")
}

model CredentialRevocation {
  id              String         @id @default(uuid())
  credentialType  CredentialType @map("credential_type")
  credentialId    String         @map("credential_id") // Badge or Licence UUID
  serialNumber    String         @map("serial_number") // CH-2026-00001 or LIC-2026-00001
  revokedAt       DateTime       @default(now()) @map("revoked_at")
  revokedByUserId String         @map("revoked_by_user_id")
  reason          String
  isPermanent     Boolean        @default(true) @map("is_permanent")

  @@index([credentialId])
  @@index([serialNumber])
  @@index([credentialType])
  @@index([revokedAt])
  @@map("credential_revocations")
}

// ==============================================================================
// 13. GIS, TRANSPORT LINES & BUS STOPS (Modules 6 & 7)
// ==============================================================================

enum StopDirection {
  ALLER
  RETOUR
  CIRCULAIRE
}

model TransportLine {
  id               String   @id @default(uuid())
  code             String   @unique // e.g. "L-01", "L-02", "L-03"
  name             String   // e.g. "Kaloum (Port) — Matoto (Rond-point)"
  colorHex         String   @default("#2563EB") @map("color_hex") // Route color e.g. #2563EB, #DC2626
  description      String?
  originName       String   @map("origin_name")
  destinationName  String   @map("destination_name")
  distanceKm       Float?   @map("distance_km")
  estimatedMinutes Int?     @map("estimated_minutes")
  isActive         Boolean  @default(true) @map("is_active")
  pathCoordinates  Json?    @map("path_coordinates") // GeoJSON LineString coordinates [[lng, lat], ...]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stops       LineStop[]
  assignments VehicleAssignment[]

  @@index([code])
  @@index([isActive])
  @@map("transport_lines")
}

model TransportStop {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. "ARR-KLM-01"
  name        String   // e.g. "Gare Centrale de Kaloum", "Madina Marché"
  communeId   String?  @map("commune_id")
  latitude    Float
  longitude   Float
  isSheltered Boolean  @default(false) @map("is_sheltered")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  commune Commune?   @relation(fields: [communeId], references: [id], onDelete: SetNull)
  lines   LineStop[]

  @@index([code])
  @@index([communeId])
  @@map("transport_stops")
}

model LineStop {
  id                  String        @id @default(uuid())
  lineId              String        @map("line_id")
  stopId              String        @map("stop_id")
  stopOrder           Int           @map("stop_order") // 1, 2, 3...
  direction           StopDirection @default(ALLER)
  distanceFromStartKm Float?        @map("distance_from_start_km")

  createdAt DateTime @default(now()) @map("created_at")

  line TransportLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  stop TransportStop @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@unique([lineId, stopId, direction])
  @@index([lineId])
  @@index([stopId])
  @@index([stopOrder])
  @@map("line_stops")
}

// ==============================================================================
// 14. TICKETING & DOUBLE-ENTRY IMMUTABLE FINANCIAL LEDGER (GNF)
// ==============================================================================

enum TicketBatchStatus {
  EN_STOCK_CENTRAL
  ALLOUE_DISTRIBUTEUR
  EPUISE
  ANNULE
}

enum PaymentMethod {
  ESPECES
  ORANGE_MONEY
  MTN_MOMO
  VIREMENT_BANCAIRE
}

enum FinancialAccountType {
  ACTIF
  PASSIF
  PRODUIT
  CHARGE
}

enum LedgerTransactionType {
  ALLOCATION_DISTRIBUTEUR
  VENTE_TICKETS_DIRECTE
  ENCAISSEMENT_MOBILE_MONEY
  VERSEMENT_BANQUE_BCRG
  REGULARISATION_COMPTABLE
}

model TicketTariff {
  id              String   @id @default(uuid())
  code            String   @unique // e.g. "T-2000", "T-5000", "T-10000"
  name            String   // e.g. "Ticket Standard Urbain 2 000 GNF"
  priceGnf        Int      // In Guinean Francs (GNF)
  vehicleCategory String?  @map("vehicle_category") // TAXI_COMMUNAL, MINIBUS_URBAIN...
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  batches TicketBatch[]
  sales   TicketSale[]

  @@map("ticket_tariffs")
}

model TicketBatch {
  id                String            @id @default(uuid())
  batchNumber       String            @unique @map("batch_number") // e.g. "LOT-2026-0001"
  tariffId          String            @map("tariff_id")
  startSerial       BigInt            @map("start_serial") // e.g. 1000001
  endSerial         BigInt            @map("end_serial")   // e.g. 1000100 (Carnet de 100)
  totalCount        Int               @map("total_count")
  remainingCount    Int               @map("remaining_count")
  status            TicketBatchStatus @default(EN_STOCK_CENTRAL)
  allocatedToUserId String?           @map("allocated_to_user_id")
  allocatedAt       DateTime?         @map("allocated_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  tariff          TicketTariff @relation(fields: [tariffId], references: [id])
  allocatedToUser User?        @relation(fields: [allocatedToUserId], references: [id])
  sales           TicketSale[]

  @@index([batchNumber])
  @@index([status])
  @@index([allocatedToUserId])
  @@map("ticket_batches")
}

model TicketSale {
  id              String        @id @default(uuid())
  receiptNumber   String        @unique @map("receipt_number") // e.g. "REC-2026-00042"
  tariffId        String        @map("tariff_id")
  batchId         String        @map("batch_id")
  sellerUserId    String        @map("seller_user_id") // Agent or Distributeur
  quantitySold    Int           @map("quantity_sold")
  unitPriceGnf    Int           @map("unit_price_gnf")
  totalAmountGnf  BigInt        @map("total_amount_gnf") // quantity * unitPrice
  paymentMethod   PaymentMethod @default(ESPECES) @map("payment_method")
  paymentRef      String?       @map("payment_ref") // Orange Money / MTN MoMo Transaction ID
  buyerName       String?       @map("buyer_name")
  buyerPhone      String?       @map("buyer_phone")
  saleTimestamp   DateTime      @default(now()) @map("sale_timestamp")

  tariff     TicketTariff @relation(fields: [tariffId], references: [id])
  batch      TicketBatch  @relation(fields: [batchId], references: [id])
  sellerUser User         @relation(fields: [sellerUserId], references: [id])

  @@index([receiptNumber])
  @@index([sellerUserId])
  @@index([saleTimestamp])
  @@map("ticket_sales")
}

model FinancialAccount {
  id          String               @id @default(uuid())
  accountCode String               @unique @map("account_code") // e.g. "512100", "531100", "706100"
  name        String               // e.g. "Banque Centrale (BCRG)", "Caisse Principale AOTUC"
  type        FinancialAccountType
  balanceGnf  BigInt               @default(0) @map("balance_gnf")
  currency    String               @default("GNF")
  isActive    Boolean              @default(true) @map("is_active")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  debitEntries  FinancialLedgerEntry[] @relation("DebitAccount")
  creditEntries FinancialLedgerEntry[] @relation("CreditAccount")

  @@map("financial_accounts")
}

model FinancialLedgerEntry {
  id              String                @id @default(uuid())
  entryNumber     String                @unique @map("entry_number") // Sequential unique: "JNL-2026-000001"
  debitAccountId  String                @map("debit_account_id")
  creditAccountId String                @map("credit_account_id")
  amountGnf       BigInt                @map("amount_gnf") // Strictly positive double-entry balance
  transactionType LedgerTransactionType @map("transaction_type")
  referenceCode   String                @map("reference_code") // Sale receipt, batch allocation ID, or bank deposit
  description     String
  actorUserId     String                @map("actor_user_id")
  createdAt       DateTime              @default(now()) @map("created_at") // IMMUTABLE

  debitAccount  FinancialAccount @relation("DebitAccount", fields: [debitAccountId], references: [id])
  creditAccount FinancialAccount @relation("CreditAccount", fields: [creditAccountId], references: [id])
  actorUser     User             @relation(fields: [actorUserId], references: [id])

  @@index([entryNumber])
  @@index([debitAccountId])
  @@index([creditAccountId])
  @@index([createdAt])
  @@map("financial_ledger_entries")
}
