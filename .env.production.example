# ==============================================================================
# AOTUC-TRANSPORT v2.0 — Production Environment Template
# ==============================================================================

# Database Credentials
POSTGRES_DB=aotuc_transport
POSTGRES_USER=aotuc_admin
POSTGRES_PASSWORD=CHANGEME_IN_PRODUCTION_COMPLEX_PASSWORD_2026
POSTGRES_PORT=5432

# Application Security Keys
JWT_ACCESS_SECRET=CHANGEME_MIN_32_CHARS_ACCESS_SECRET_KEY
JWT_REFRESH_SECRET=CHANGEME_MIN_32_CHARS_REFRESH_SECRET_KEY
CORS_ORIGIN=https://transport.aotuc.gov.gn

# Storage Configuration
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/app/storage/documents

# SMS Gateway Configuration
SMS_PROVIDER=MOCK # Set to ORANGE_GUINEA or MTN_GUINEA in production
ORANGE_SMS_API_KEY=
MTN_SMS_API_KEY=

# Asymmetric Cryptography Key Version
QR_KEY_ID=aotuc-2026-v1
